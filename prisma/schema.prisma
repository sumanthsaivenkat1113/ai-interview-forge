// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}







//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum InterviewType {
  FULL_MOCK
  CODING
  THEORY
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id              Int       @id @default(autoincrement())
  clerkId         String    @unique
  email           String    @unique
  name            String
  profileImageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLoginAt DateTime?

  workspaces Workspace[]
}

//////////////////////////////////////////////////////
// WORKSPACE
//////////////////////////////////////////////////////

model Workspace {
  id        Int      @id @default(autoincrement())
  name      String

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumes         Resume[]
  jobDescriptions JobDescription[]
  interviews      Interview[]

  @@index([userId])
}

//////////////////////////////////////////////////////
// RESUME
//////////////////////////////////////////////////////

model Resume {
  id      Int     @id @default(autoincrement())
  rawText String? @db.Text

  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills      ResumeSkill[]
  experiences ResumeExperience[]
  projects    ResumeProject[]
  otherFields ResumeOtherField[]

  interviews Interview[]

  @@index([workspaceId])
}

model ResumeSkill {
  id    Int    @id @default(autoincrement())
  skill String

  resumeId Int
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeExperience {
  id         Int    @id @default(autoincrement())
  experience String @db.Text

  resumeId Int
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeProject {
  id      Int    @id @default(autoincrement())
  project String @db.Text

  resumeId Int
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeOtherField {
  id         Int     @id @default(autoincrement())
  fieldName  String
  fieldValue String? @db.Text

  resumeId Int
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

//////////////////////////////////////////////////////
// JOB DESCRIPTION
//////////////////////////////////////////////////////

model JobDescription {
  id          Int    @id @default(autoincrement())
  description String @db.Text

  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  interviews Interview[]

  @@index([workspaceId])
}

//////////////////////////////////////////////////////
// INTERVIEW
//////////////////////////////////////////////////////

model Interview {
  id Int @id @default(autoincrement())

  interviewType InterviewType
  status        InterviewStatus @default(IN_PROGRESS)

  subject           String?
  targetCompany     String?
  targetRole        String?
  yearsOfExperience Int?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  resumeId Int?
  resume   Resume? @relation(fields: [resumeId], references: [id])

  jobDescriptionId Int?
  jobDescription   JobDescription? @relation(fields: [jobDescriptionId], references: [id])

  theoryQuestions TheoryQuestion[]
  codingQuestions CodingQuestion[]

  performanceResult PerformanceResult?

  @@index([workspaceId])
  @@index([resumeId])
  @@index([jobDescriptionId])
}

//////////////////////////////////////////////////////
// THEORY
//////////////////////////////////////////////////////

model TheoryQuestion {
  id         Int    @id @default(autoincrement())
  questionNo Int
  question   String @db.Text

  difficulty String?
  topic      String?

  createdAt DateTime @default(now())

  interviewId Int
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  answers    TheoryAnswer[]
  evaluation TheoryEvaluation?

  @@index([interviewId])
}

model TheoryAnswer {
  id     Int     @id @default(autoincrement())
  answer String? @db.Text

  answeredAt DateTime @default(now())

  theoryQuestionId Int
  theoryQuestion   TheoryQuestion @relation(fields: [theoryQuestionId], references: [id], onDelete: Cascade)

  @@index([theoryQuestionId])
}

model TheoryEvaluation {
  id Int @id @default(autoincrement())

  accuracyScore       Int?
  communicationScore  Int?
  problemSolvingScore Int?

  overallScore Int?
  maxScore     Int @default(10)

  strengths   String? @db.Text
  improvements String? @db.Text
  feedback     String? @db.Text

  evaluatedBy String @default("AI")
  evaluatedAt DateTime @default(now())

  theoryQuestionId Int             @unique
  theoryQuestion   TheoryQuestion  @relation(fields: [theoryQuestionId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////
// CODING
//////////////////////////////////////////////////////

model CodingQuestion {
  id               Int    @id @default(autoincrement())
  questionNo       Int
  title            String?
  problemStatement String @db.Text

  difficulty String?

  examples Json?

  constraints String? @db.Text
  explanation String? @db.Text

  createdAt DateTime @default(now())

  interviewId Int
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  answers    CodingAnswer[]
  evaluation CodingEvaluation?

  @@index([interviewId])
}

model CodingAnswer {
  id       Int     @id @default(autoincrement())
  language String?
  solution String? @db.Text

  answeredAt DateTime @default(now())

  codingQuestionId Int
  codingQuestion   CodingQuestion @relation(fields: [codingQuestionId], references: [id], onDelete: Cascade)

  @@index([codingQuestionId])
}

model CodingEvaluation {
  id Int @id @default(autoincrement())

  correctnessScore    Int?
  efficiencyScore     Int?
  codeQualityScore    Int?
  problemSolvingScore Int?

  overallScore Int?
  maxScore     Int @default(100)

  strengths    String? @db.Text
  improvements String? @db.Text
  feedback     String? @db.Text

  evaluatedBy String @default("AI")
  evaluatedAt DateTime @default(now())

  codingQuestionId Int             @unique
  codingQuestion   CodingQuestion  @relation(fields: [codingQuestionId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////
// PERFORMANCE RESULT
//////////////////////////////////////////////////////

model PerformanceResult {
  id Int @id @default(autoincrement())

  theoryAverageScore         Decimal? @db.Decimal(5,2)
  codingAverageScore         Decimal? @db.Decimal(5,2)
  communicationAverageScore  Decimal? @db.Decimal(5,2)
  problemSolvingAverageScore Decimal? @db.Decimal(5,2)
  overallScore               Decimal? @db.Decimal(5,2)

  strengths       String? @db.Text
  areasToImprove  String? @db.Text
  overallFeedback String? @db.Text

  createdAt DateTime @default(now())

  interviewId Int        @unique
  interview   Interview  @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}
