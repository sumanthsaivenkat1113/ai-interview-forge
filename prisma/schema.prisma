

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id              Int         @id @default(autoincrement())
  clerkId         String      @unique
  email           String      @unique
  name            String
  profileImageUrl String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  lastLoginAt     DateTime?
  workspaces      Workspace[]
}

//////////////////////////////////////////////////////
// WORKSPACE
//////////////////////////////////////////////////////

model Workspace {
  id                  String            @id @default(uuid())
  workspace           String
  target_company      String
  target_role         String
  years_of_experience Int
  userId              Int
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume              ResumePdfDetails?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  questions           questions[]
  codingQuestions     CodingQuestion[]
  subjects            Subject?

  @@unique([userId, workspace])
}

//////////////////////////////////////////////////////
// SUBJECT
//////////////////////////////////////////////////////

model Subject {
  id          String    @id @default(uuid())
  workspaceId String    @unique
  subject     String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

//////////////////////////////////////////////////////
// RESUME PDF DETAILS
//////////////////////////////////////////////////////

model ResumePdfDetails {
  id          String    @id @default(uuid())
  fileName    String
  text        String
  pages       Int
  skills      String
  project     String
  experience  String
  otherFields String
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

//////////////////////////////////////////////////////
// QUESTIONS 
//////////////////////////////////////////////////////

model questions {
  id          String    @id @default(uuid())
  qno         Int
  question    String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  answers   answers[]
}

model CodingQuestion {
  id                String @id @default(uuid())
  qno               Int
  problem_statement String
  examples          Json

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  codingAnswers CodingAnswers[]

  @@index([workspaceId])
}

//////////////////////////////////////////////////////
// ANSWERS
//////////////////////////////////////////////////////

model answers {
  id         String    @id @default(uuid())
  qno        Int
  answer     String
  questionId String
  questions  questions @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model CodingAnswers {
  id               String         @id @default(uuid())
  answer           String
  codingQuestionId String
  CodingQuestions  CodingQuestion @relation(fields: [codingQuestionId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

//////////////////////////////////////////////////////
// STT
//////////////////////////////////////////////////////

model stt {
  id   String @id @default(uuid())
  text String
}

//////////////////////////////////////////////////////
// INTERVIEW EVALUATION
//////////////////////////////////////////////////////

model InterviewEvaluation {
  id String @id @default(uuid()) @db.Uuid

  workspace          String  @unique
  totalQuestions     Int
  evaluatedQuestions Int
  overallScore       Decimal @db.Decimal(5, 2)
  performanceLevel   String
  recommendation     String

  categoryScores   CategoryScore[]
  strengths        EvaluationStrength[]
  improvementAreas EvaluationImprovementArea[]
  knowledgeGaps    KnowledgeGap[]
  timeTaken        EvaluationTimeTaken?
  apiRequests      ApiRequest[]
  questions        QuestionEvaluation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspace])
  @@index([createdAt])
}

model CategoryScore {
  id String @id @default(uuid()) @db.Uuid

  evaluationId String              @db.Uuid
  evaluation   InterviewEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  category String
  score    Decimal @db.Decimal(5, 2)

  @@unique([evaluationId, category])
  @@index([evaluationId])
}

model EvaluationStrength {
  id String @id @default(uuid()) @db.Uuid

  evaluationId String              @db.Uuid
  evaluation   InterviewEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  description String

  @@index([evaluationId])
}

model EvaluationImprovementArea {
  id String @id @default(uuid()) @db.Uuid

  evaluationId String              @db.Uuid
  evaluation   InterviewEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  description String

  @@index([evaluationId])
}

model KnowledgeGap {
  id String @id @default(uuid()) @db.Uuid

  evaluationId String              @db.Uuid
  evaluation   InterviewEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  description String

  @@index([evaluationId])
}

model EvaluationTimeTaken {
  id String @id @default(uuid()) @db.Uuid

  evaluationId String              @unique @db.Uuid
  evaluation   InterviewEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  milliseconds Decimal @db.Decimal(12, 2)
  seconds      Decimal @db.Decimal(10, 2)
}

model ApiRequest {
  id String @id @default(uuid()) @db.Uuid

  evaluationId String              @db.Uuid
  evaluation   InterviewEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  chunk            Int
  questions        Int
  timeTakenSeconds Decimal @db.Decimal(10, 2)

  @@unique([evaluationId, chunk])
  @@index([evaluationId])
}

model QuestionEvaluation {
  id String @id @default(uuid()) @db.Uuid

  evaluationId String              @db.Uuid
  evaluation   InterviewEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  qno Int

  accuracy  Decimal @db.Decimal(5, 2)
  depth     Decimal @db.Decimal(5, 2)
  clarity   Decimal @db.Decimal(5, 2)
  relevance Decimal @db.Decimal(5, 2)

  questionScore Decimal @db.Decimal(5, 2)

  missingConcepts QuestionMissingConcept[]

  @@unique([evaluationId, qno])
  @@index([evaluationId])
}

model QuestionMissingConcept {
  id String @id @default(uuid()) @db.Uuid

  questionEvaluationId String             @db.Uuid
  questionEvaluation   QuestionEvaluation @relation(fields: [questionEvaluationId], references: [id], onDelete: Cascade)

  concept String

  @@index([questionEvaluationId])
}

model CodingEvaluation {
  id String @id @default(uuid())

  workspaceId String @unique

  workspace  String @unique
  targetRole String
  language   String @default("JavaScript")

  overallScore   Int
  classification String // Excellent | Good | Average | Needs Improvement | Poor
  summary        String @db.Text

  questions CodingEvaluationQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@map("coding_evaluations")
}

model CodingEvaluationQuestion {
  id String @id @default(uuid())

  evaluationId String
  evaluation   CodingEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  qno Int

  algorithmProblemSolving Int
  codeCorrectness         Int
  timeComplexity          Int
  spaceComplexity         Int
  edgeCases               Int
  testPerformance         Int
  codeQuality             Int
  efficiency              Int

  expectedTimeComplexity   String?
  expectedSpaceComplexity  String?
  candidateTimeComplexity  String?
  candidateSpaceComplexity String?
  isCorrect                Boolean
  testsPassed              Int
  testsFailed              Int

  strengths      String[]
  improvements   String[]
  criticalIssues String[]

  createdAt DateTime @default(now())

  @@unique([evaluationId, qno])
  @@map("coding_evaluation_questions")
}
