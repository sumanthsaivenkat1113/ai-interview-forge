// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id              Int         @id @default(autoincrement())
  clerkId         String      @unique
  email           String      @unique
  name            String
  profileImageUrl String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  lastLoginAt     DateTime?
  workspaces      Workspace[]
}

//////////////////////////////////////////////////////
// WORKSPACE
//////////////////////////////////////////////////////

model Workspace {
  id                  String            @id @default(uuid())
  workspace           String
  target_company      String
  target_role         String
  years_of_experience Int
  userId              Int
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume              ResumePdfDetails?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  questions           questions[]
  codingQuestions     CodingQuestion[]

  @@unique([userId, workspace])
}

//////////////////////////////////////////////////////
// RESUME PDF DETAILS
//////////////////////////////////////////////////////

model ResumePdfDetails {
  id          String    @id @default(uuid())
  fileName    String
  text        String
  pages       Int
  skills      String
  project     String
  experience  String
  otherFields String
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

//////////////////////////////////////////////////////
// QUESTIONS 
//////////////////////////////////////////////////////

model questions {
  id          String    @id @default(uuid())
  qno         Int
  question    String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  answers   answers[]
}

model CodingQuestion {
  id                String @id @default(uuid())
  qno               Int
  problem_statement String
  examples          Json

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  codingAnswers CodingAnswers[]

  @@index([workspaceId])
}

//////////////////////////////////////////////////////
// ANSWERS
//////////////////////////////////////////////////////

model answers {
  id         String    @id @default(uuid())
  qno        Int
  answer     String
  questionId String
  questions  questions @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model CodingAnswers {
  id               String         @id @default(uuid())
  answer           String
  codingQuestionId String
  CodingQuestions  CodingQuestion @relation(fields: [codingQuestionId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}


//////////////////////////////////////////////////////
// STT
//////////////////////////////////////////////////////

model stt {
  id   String @id @default(uuid())
  text String
}